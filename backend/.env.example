# Copy to .env and fill in. psycopg 3 is the installed driver, hence the +psycopg.
DATABASE_URL=postgresql+psycopg://devcard:devcard_dev_only@localhost:5432/devcard
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
SECRET_KEY=your_session_secret
FERNET_KEY=your_fernet_key
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
INTERNAL_API_SECRET=your_internal_secret

# Numeric GitHub id of the site owner (always admin). Uncomment and set once you know it.
# ADMIN_GITHUB_ID=12345678
# Discord webhook for staff alerts. Optional: leave blank.
MOD_WEBHOOK_URL=
# Required only when running the approved-tag seed script.
# SEED_SYSTEM_USER_ID=1

# Optional: IGDB game search + artwork (Twitch developer app: https://dev.twitch.tv/console).
# IGDB only works with credentials created for an https site, so it is normally configured in
# production only; locally the editor falls back to the bundled Steam list.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Only set after testing X-Forwarded-For on your host (see docs/DEPLOYMENT.md). Usually 1 on Render.
# TRUSTED_PROXY_HOPS=1
